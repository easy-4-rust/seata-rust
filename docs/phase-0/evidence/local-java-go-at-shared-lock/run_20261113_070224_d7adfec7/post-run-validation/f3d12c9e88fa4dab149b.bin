  if versions!=({2} if name=='java' else {1}):raise RuntimeError('Original Java default V2 and Go V1 scope changed')
  protocols[name]=sorted(versions);tm_reports.append(dict(actor=name,begin_xid_bound=True,commit_target_bound=True,commit_success=True,tm_identified=True,phase_one_reports=reports,report_acks=acks))
