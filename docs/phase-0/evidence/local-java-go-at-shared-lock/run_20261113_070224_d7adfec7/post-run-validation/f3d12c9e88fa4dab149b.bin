    continue
   request_codes={1,7,11,13,101,103};response_codes={2:1,8:7,12:11,14:13,102:101,104:103}
   if code in request_codes:
    if not to_tc or value['kind'] not in [0,2] or (code,*key) in requests:raise RuntimeError('Original request direction/type/identity differs')
    requests[(code,*key)]=value
   elif code in response_codes:
    target=(response_codes[code],*key)
    if to_tc or value['kind']!=1 or target not in requests or target in seen:raise RuntimeError('Original response not uniquely bound')
    seen.add(target)
