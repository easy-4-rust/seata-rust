    if to_tc or value['kind'] not in [0,2]:raise RuntimeError('Original Commit callback envelope differs')
   elif code==4:
    if not to_tc or value['kind']!=1:raise RuntimeError('Original Commit reply envelope differs')
   else:raise RuntimeError('Unexpected original transaction/control message')
   if code in [102,104] and (not value['identified'] or value.get('result',1)!=1 or not value['server_version']):raise RuntimeError('Actual TM/RM identification failed')
   if code==2 and (value['result'],value['error'],value['xid'])!=(1,0,phase['xid']):raise RuntimeError('Actual Begin response does not create original SQL transaction')
   if code==7:
