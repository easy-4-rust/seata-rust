"""Only owned copies under D:/Temp are changed; source/reference files are read-only."""
from pathlib import Path
import contextlib,hashlib,importlib.util,json,os,shutil,tempfile,unittest
SOURCE=Path(os.environ.get('SEATA_SHARED_LOCK_ACTUAL','E:/workspaces/workspace-github-easy-4-rust/seata-rust-phase09-validation/docs/phase-0/evidence/local-java-go-at-shared-lock/run_20261113_070224_d7adfec7'))
s=importlib.util.spec_from_file_location('shared_lock_additional_gate',os.environ.get('SEATA_SHARED_LOCK_GATE','D:/codex-builds/shared_lock_additional_gate_20261113.py'));gate=importlib.util.module_from_spec(s);s.loader.exec_module(gate)
class SharedLockActualGuards(unittest.TestCase):
 def setUp(self):
  self.temp=tempfile.TemporaryDirectory(prefix='shared-lock-actual-',dir='D:/Temp');self.root=Path(self.temp.name);assert self.root.resolve().is_relative_to(Path('D:/Temp').resolve());self.addCleanup(self.temp.cleanup)
  def translate(value):
   if isinstance(value,str):return value.replace(str(SOURCE),str(self.root)).replace(SOURCE.as_posix(),self.root.as_posix())
   if isinstance(value,list):return [translate(v) for v in value]
   if isinstance(value,dict):return {k:translate(v) for k,v in value.items()}
   return value
  for path in SOURCE.rglob('*'):
   if not path.is_file():continue
   relative=path.relative_to(SOURCE)
   if relative.parts[0]=='source-inputs' or path.suffix=='.exe':continue
   target=self.root/relative;target.parent.mkdir(parents=True,exist_ok=True)
   if path.suffix=='.json':target.write_text(json.dumps(translate(json.loads(path.read_bytes()))),encoding='utf-8')
   elif path.suffix=='.log':target.write_text(path.read_text(encoding='utf-8',errors='replace').replace(SOURCE.as_posix(),self.root.as_posix()),encoding='utf-8')
   else:shutil.copyfile(path,target)
 def read(self):return gate.verify_additional(self.root)
 def mutate(self,actor,code,fn):
  path=self.root/actor/'proxy-events.json';events=json.loads(path.read_bytes())
  for row in events:
   if row['event']=='wire' and row['payload_type']==code:
    frame=bytearray(bytes.fromhex(row['frame_hex']));head=int.from_bytes(frame[7:9],'big');fn(frame,head);row.update(frame_hex=frame.hex(),sha256=hashlib.sha256(frame).hexdigest())
  path.write_text(json.dumps(events),encoding='utf-8')
 def test_actual_control(self):self.read()
 def test_begin_response_must_return_same_xid(self):
  self.mutate('java',2,lambda frame,head:frame.__setitem__(-3,ord('9')))
  with self.assertRaises(Exception):self.read()
 def test_commit_must_target_original_xid(self):
  self.mutate('go',7,lambda frame,head:frame.__setitem__(-3,ord('9')))
  with self.assertRaises(Exception):self.read()
 def test_commit_response_must_be_success(self):
  self.mutate('java',8,lambda frame,head:frame.__setitem__(head+3,1))
  with self.assertRaises(Exception):self.read()
 def test_commit_response_must_be_async_or_committed(self):
  self.mutate('go',8,lambda frame,head:frame.__setitem__(-1,17))
  with self.assertRaises(Exception):self.read()
 def test_tm_identification_must_succeed(self):
  self.mutate('go',102,lambda frame,head:frame.__setitem__(head+2,0))
  with self.assertRaises(Exception):self.read()
 def test_v2_tm_identified_must_be_true_separate_from_result(self):
  self.mutate('java',102,lambda frame,head:frame.__setitem__(head+3,0))
  with self.assertRaises(Exception):self.read()
 def test_report_must_match_original_xid(self):
  def fn(frame,head):
   size=int.from_bytes(frame[head+2:head+4],'big');frame[head+4+size-1]=ord('9')
  self.mutate('go',13,fn)
  with self.assertRaises(Exception):self.read()
 def test_report_must_match_original_branch(self):
  def fn(frame,head):
   size=int.from_bytes(frame[head+2:head+4],'big');frame[head+4+size+7]^=1
  self.mutate('go',13,fn)
  with self.assertRaises(Exception):self.read()
 def test_report_must_be_phase_one_done(self):
  def fn(frame,head):
   size=int.from_bytes(frame[head+2:head+4],'big');frame[head+4+size+8]=1
  self.mutate('go',13,fn)
  with self.assertRaises(Exception):self.read()
 def test_report_ack_must_be_successful(self):
  self.mutate('go',14,lambda frame,head:frame.__setitem__(-1,1))
  with self.assertRaises(Exception):self.read()
 def test_initial_physical_row_must_be_1000(self):
  (self.root/'initial.tsv').write_text('1\t999\n0\n',encoding='utf-8')
  with self.assertRaises(Exception):self.read()
 def test_initial_undo_must_be_empty(self):
  (self.root/'initial.tsv').write_text('1\t1000\n1\n',encoding='utf-8')
  with self.assertRaises(Exception):self.read()
 def test_final_row_width_must_be_exact(self):
  (self.root/'final.tsv').write_text('1\t800\textra\n0\n',encoding='utf-8')
  with self.assertRaises(Exception):self.read()
 def test_java_datasource_must_load_original_class(self):
  path=self.root/'java/sdk-stdout.log';lines=path.read_text().splitlines();lines=[line.split(' source: ')[0]+' source: file:/D:/wrong/' if ' org.apache.seata.rm.datasource.DataSourceProxy source: ' in line else line for line in lines];path.write_text('\n'.join(lines),encoding='utf-8')
  with self.assertRaises(Exception):self.read()
 def test_mysql_driver_must_load_pinned_jar(self):
  path=self.root/'java/sdk-stdout.log';lines=path.read_text().splitlines();lines=[line.split(' source: ')[0]+' source: file:/D:/wrong.jar' if ' com.mysql.cj.jdbc.MysqlDataSource source: ' in line else line for line in lines];path.write_text('\n'.join(lines),encoding='utf-8')
  with self.assertRaises(Exception):self.read()
 def test_tc_file_lock_manager_must_load_original_jar(self):
  path=self.root/'tc/tc-stdout.log';lines=path.read_text().splitlines();lines=[line.split(' source: ')[0]+' source: file:/D:/wrong/' if ' org.apache.seata.server.storage.file.lock.FileLockManager source: ' in line else line for line in lines];path.write_text('\n'.join(lines),encoding='utf-8')
  with self.assertRaises(Exception):self.read()
 def test_compiled_actor_bytes_must_match_manifest(self):
  path=self.root/'compiled/SharedLockJavaActor.class';path.write_bytes(path.read_bytes()+b'x')
  with self.assertRaises(Exception):self.read()
 def test_namespace_query_cannot_be_relabelled(self):
  path=self.root/'query-java-held-go-java.json';value=json.loads(path.read_bytes());value['resource']='wrong';path.write_text(json.dumps(value),encoding='utf-8')
  with self.assertRaises(Exception):self.read()
 def test_phase_one_undo_cannot_be_empty_even_if_sql_agrees(self):
  path=self.root/'java/phase-one.json';phase=json.loads(path.read_bytes());old=phase['undo_hex'];phase['undo_hex']='';path.write_text(json.dumps(phase),encoding='utf-8')
  for name in ['java-held.tsv','both-held.tsv']:
   path=self.root/name;path.write_text(path.read_text().replace(old,''),encoding='utf-8')
  with self.assertRaises(Exception):self.read()
if __name__=='__main__':unittest.main()
