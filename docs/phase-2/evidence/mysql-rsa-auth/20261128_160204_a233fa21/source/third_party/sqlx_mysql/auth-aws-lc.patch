-// https://docs.rs/rsa/0.3.0/rsa/struct.RSAPublicKey.html?search=#example-1
-fn parse_rsa_pub_key(key: &[u8]) -> Result<RsaPublicKey, Error> {
+// MySQL 原 SPKI 公钥格式；通过受维护的 AWS-LC 公钥接口解析。
+fn parse_rsa_pub_key(key: &[u8]) -> Result<PublicEncryptingKey, Error> {
     let pem = std::str::from_utf8(key).map_err(Error::protocol)?;
 
     // This takes advantage of the knowledge that we know
     // we are receiving a PKCS#8 RSA Public Key at all
     // times from MySQL
 
-    RsaPublicKey::from_public_key_pem(pem).map_err(Error::protocol)
-}
+    let (label, der) = pem_rfc7468::decode_vec(pem.as_bytes()).map_err(Error::protocol)?;
+    if label != "PUBLIC KEY" {
+        return Err(Error::protocol("MySQL SPKI PUBLIC KEY required"));
+    }
+    let key = PublicEncryptingKey::from_der(&der).map_err(Error::protocol)?;
+    // 保持原 rsa::RsaPublicKey::MAX_SIZE 上限；弱键由新后端显式拒绝。
+    if key.key_size_bits() > 4096 {
+        return Err(Error::protocol(
+            "MySQL RSA key exceeds original 4096-bit budget",
+        ));
+    }
+    Ok(key)
+}
