CREATE TABLE undo_decimal_types (
 id INT PRIMARY KEY,d DECIMAL(65,30),u DECIMAL(5,2) UNSIGNED,n DECIMAL(3,0)
) ENGINE=InnoDB;
INSERT INTO undo_decimal_types VALUES
 (1,12345678901234567890123456789012345.123456789012345678901234567890,999.99,-999),
