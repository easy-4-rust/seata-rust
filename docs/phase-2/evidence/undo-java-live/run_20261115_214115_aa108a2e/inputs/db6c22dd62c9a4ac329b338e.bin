-- Owned oracle fixture only. Native auth is enabled only in this private test container.
SET NAMES utf8mb4;
CREATE USER 'undo_oracle'@'%' IDENTIFIED WITH mysql_native_password BY 'seata-mysql-fixture-only';
GRANT SELECT ON `__DATABASE__`.* TO 'undo_oracle'@'%';
CREATE TABLE undo_integer_types (
 id BIGINT PRIMARY KEY,s8 TINYINT,s16 SMALLINT,s24 MEDIUMINT,s32 INT,s64 BIGINT,
 u8 TINYINT UNSIGNED,u16 SMALLINT UNSIGNED,u24 MEDIUMINT UNSIGNED,u32 INT UNSIGNED,u64 BIGINT UNSIGNED,
 boolish TINYINT(1),boolish_unsigned TINYINT(1) UNSIGNED
) ENGINE=InnoDB;
INSERT INTO undo_integer_types VALUES
 (1,-128,-32768,-8388608,-2147483648,-9223372036854775808,255,65535,16777215,4294967295,18446744073709551615,2,2),
 (2,127,32767,8388607,2147483647,9223372036854775807,0,0,0,0,0,0,0),
 (3,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL,NULL);
CREATE TABLE undo_text_types (
 id INT PRIMARY KEY,c CHAR(3) CHARACTER SET ascii,v VARCHAR(50) CHARACTER SET utf8mb4,
 tt TINYTEXT CHARACTER SET utf8mb4,t TEXT CHARACTER SET utf8mb4,
 mt MEDIUMTEXT CHARACTER SET utf8mb4,lt LONGTEXT CHARACTER SET utf8mb4
) ENGINE=InnoDB;
INSERT INTO undo_text_types VALUES
 (1,'x ','中文🦀','tiny','text','medium','long'),
 (2,'','',CONVERT(0x00220a5c USING utf8mb4),'','',''),
 (3,NULL,NULL,NULL,NULL,NULL,NULL);
CREATE TABLE undo_binary_types (
 id INT PRIMARY KEY,b BINARY(4),v VARBINARY(32),tb TINYBLOB,t BLOB,mb MEDIUMBLOB,lb LONGBLOB
) ENGINE=InnoDB;
INSERT INTO undo_binary_types VALUES
 (1,X'ff',X'00ff7f00',X'00ff',X'80ff',X'00ff7f80',X'0001ff'),
