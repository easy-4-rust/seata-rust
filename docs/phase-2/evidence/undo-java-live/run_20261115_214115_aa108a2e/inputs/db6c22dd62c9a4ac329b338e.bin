CREATE TABLE undo_composite (b INT NOT NULL,a BIGINT UNSIGNED NOT NULL,v VARCHAR(30),PRIMARY KEY(a,b)) ENGINE=InnoDB;
INSERT INTO undo_composite VALUES (7,18446744073709551615,'last'),(-1,1,'first'),(8,1,NULL);
CREATE TABLE undo_empty (id INT PRIMARY KEY,v VARCHAR(10)) ENGINE=InnoDB;
