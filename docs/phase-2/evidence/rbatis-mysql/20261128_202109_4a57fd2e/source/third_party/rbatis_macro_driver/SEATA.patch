+        Ok(args) => args,
+        Err(e) => return e.to_compile_error().into(),
+    };
+    let target_fn: ItemFn = match syn::parse(func) {
+        Ok(target_fn) => target_fn,
+        Err(e) => return e.to_compile_error().into(),
+    };
+    let stream = match impl_macro_py_sql(&target_fn, args) {
+        Ok(stream) => stream,
+        Err(e) => return crate::util::error_with_stub(e, &target_fn),
+    };
