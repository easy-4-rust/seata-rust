new file mode 100644
--- /dev/null
+++ b/pkg/remoting/getty/java_v1_inflight.go
@@ -0,0 +1,123 @@
+// Copyright 2026 Seata-Rust contributors. Licensed under the Apache License, Version 2.0.
+package getty
+
+import (
+	"context"
+	"errors"
+	getty "github.com/apache/dubbo-getty"
+	"seata.apache.org/seata-go/v2/pkg/protocol/message"
+	"seata.apache.org/seata-go/v2/pkg/remoting/rpc"
+	"sync"
+	"time"
+)
+
+var errJavaV1ConnectionClosed = errors.New("connection closed")
+
+// javaV1Pending 绑定实际会话与原future；mutex只保护开始写入的阶段，绝不持锁调用网络接口。
+type javaV1Pending struct {
+	mutex     sync.Mutex
+	session   getty.Session
+	future    *message.MessageFuture
+	attempted bool
+}
+
+func javaV1TransportEnabled() bool { return sessionManager != nil && sessionManager.javaV1Profile }
+func javaV1LocalError(id int32, cause error) error {
+	return &JavaV1TransportError{ID: id, Classification: "LocalFailureBeforeSend", Cause: cause}
+}
+func (p *javaV1Pending) fail(cause error) {
+	p.mutex.Lock()
+	defer p.mutex.Unlock()
+	kind := "LocalFailureBeforeSend"
+	if p.attempted {
+		kind = "UnknownOutcome"
+	}
+	p.future.CompleteWithError(nil, &JavaV1TransportError{ID: p.future.ID, Classification: kind, Cause: cause})
+}
+
+// sendJavaV1Sync 预检、登记、最多写入一次；完成后只删除本次所有的记录。
+func (g *GettyRemoting) sendJavaV1Sync(msg message.RpcMessage, s getty.Session, callback callbackMethod) (interface{}, error) {
+	if sessionManager.gettyConf == nil {
+		return nil, javaV1LocalError(msg.ID, errors.New("missing captured session configuration"))
+	}
+	handler, err := sessionManager.sessionPackageHandler()
+	if err != nil {
+		return nil, javaV1LocalError(msg.ID, err)
+	}
+	if _, err = handler.Write(s, msg); err != nil {
+		return nil, javaV1LocalError(msg.ID, err)
+	}
+	if s == nil {
+		s = sessionManager.selectSession(msg.Body)
+	}
+	if s == nil || s.IsClosed() {
+		return nil, javaV1LocalError(msg.ID, errJavaV1ConnectionClosed)
+	}
+	future := message.NewMessageFuture(msg)
+	entry := &javaV1Pending{session: s, future: future}
+	g.javaV1StateMutex.Lock()
+	if _, loaded := g.javaV1Pending.LoadOrStore(msg.ID, entry); loaded {
+		g.javaV1StateMutex.Unlock()
+		return nil, javaV1LocalError(msg.ID, errors.New("request ID already pending"))
+	}
+	if _, loaded := g.futures.LoadOrStore(msg.ID, future); loaded {
+		g.javaV1Pending.CompareAndDelete(msg.ID, entry)
+		g.javaV1StateMutex.Unlock()
+		return nil, javaV1LocalError(msg.ID, errors.New("request ID already in use"))
+	}
+	g.javaV1StateMutex.Unlock()
+	defer func() {
+		g.javaV1StateMutex.Lock()
+		defer g.javaV1StateMutex.Unlock()
+		g.futures.CompareAndDelete(msg.ID, future)
+		g.javaV1Pending.CompareAndDelete(msg.ID, entry)
+	}()
+	entry.mutex.Lock()
+	select {
+	case <-future.Done:
+		entry.mutex.Unlock()
+		return future.Response, future.Err
+	default:
+	}
+	if s.IsClosed() {
+		entry.mutex.Unlock()
+		return nil, javaV1LocalError(msg.ID, errJavaV1ConnectionClosed)
+	}
+	entry.attempted = true
+	entry.mutex.Unlock()
+	rpc.BeginCount(s.RemoteAddr())
+	defer rpc.EndCount(s.RemoteAddr())
+	// WritePkg返回值不能证明TC未接收；写入期间关闭和返回写错误均保守发布UnknownOutcome。
+	_, _, err = s.WritePkg(msg, 0)
+	if err != nil {
+		entry.fail(err)
+	}
+	timer := time.NewTimer(rpcRequestTimeout)
+	defer timer.Stop()
+	select {
+	case <-future.Done:
+	case <-timer.C:
+		entry.fail(context.DeadlineExceeded)
+		<-future.Done
+	}
+	if future.Err != nil {
+		return nil, future.Err
+	}
+	if callback != nil {
+		// 原future使用容量1的单消费通知，前面的等待已取走令牌；交还给原SDK callback完成契约校验。
+		future.Done <- struct{}{}
+		return callback(msg, future)
+	}
+	return future.Response, nil
+}
+
+// failJavaV1Session 只完成实际属于该会话的等待；已发布响应通过future的CAS保持不变。
+func (g *GettyRemoting) failJavaV1Session(s getty.Session, cause error) {
+	g.javaV1Pending.Range(func(_, value interface{}) bool {
+		entry := value.(*javaV1Pending)
+		if entry.session == s {
+			entry.fail(cause)
+		}
+		return true
+	})
+}
diff --git a/pkg/remoting/getty/java_v1_transport_error.go b/pkg/remoting/getty/java_v1_transport_error.go
new file mode 100644
--- /dev/null
+++ b/pkg/remoting/getty/java_v1_transport_error.go
@@ -0,0 +1,26 @@
+// Copyright 2026 Seata-Rust contributors. Licensed under the Apache License, Version 2.0.
+package getty
+
+import "fmt"
+
+// JavaV1TransportError 保留发送阶段与原始原因；结果未知不表示TC拒绝，更不允许自动重发。
+// 对应Java: NettyClient请求等待/连接异常边界；正式Rust错误API遵循ADR-0008另行实现。
+type JavaV1TransportError struct {
+	ID             int32
+	Classification string
+	Cause          error
+}
+
+// Error 只输出请求ID、阶段与原因，不包含业务消息正文。
+func (e *JavaV1TransportError) Error() string {
+	return fmt.Sprintf("Java V1 request %d %s: %v", e.ID, e.Classification, e.Cause)
+}
+
+// Outcome 返回 LocalFailureBeforeSend 或 UnknownOutcome。
+func (e *JavaV1TransportError) Outcome() string { return e.Classification }
+
+// RequestID 返回分配的外层ID；分配前的本地错误为0。
+func (e *JavaV1TransportError) RequestID() int32 { return e.ID }
+
+// Unwrap 供errors.Is/As检查超时、连接或写错误的原始原因。
+func (e *JavaV1TransportError) Unwrap() error { return e.Cause }
diff --git a/pkg/remoting/getty/java_v1_response_guard.go b/pkg/remoting/getty/java_v1_response_guard.go
new file mode 100644
--- /dev/null
+++ b/pkg/remoting/getty/java_v1_response_guard.go
@@ -0,0 +1,140 @@
+// Copyright 2026 Seata-Rust contributors. Licensed under the Apache License, Version 2.0.
+package getty
+
+import (
+	"context"
+	getty "github.com/apache/dubbo-getty"
+	"seata.apache.org/seata-go/v2/pkg/protocol/message"
+)
+
+type javaV1ResponseGuardKey struct{}
+
+// javaV1ResponseGuard 在入站时捕获对象身份；处理器暂停后也不能按重用的ID重新寻找等待者。
+type javaV1ResponseGuard struct {
+	id        int32
+	future    *message.MessageFuture
+	request   *message.MergedWarpMessage
+	ids       []int32
+	children  []*message.MessageFuture
+	plan      *javaV1ReplyPlan
+	planError error
+}
+
+func javaV1ReplyBody(body interface{}) bool {
+	kind, known := javaV1SDKKind(body)
+	if !known {
+		return false
+	}
+	switch kind {
+	case 2, 4, 6, 8, 10, 12, 14, 16, 18, 22, 60, 102, 104:
+		return true
+	}
+	return false
+}
+func javaV1ReplyEnvelopeError(r message.RpcMessage) error {
+	reply := javaV1ReplyBody(r.Body)
+	if (r.Type == message.RequestTypeResponse && !reply) || (r.Type != message.RequestTypeResponse && reply) {
+		return &JavaV1UnknownReplyError{Reason: "response envelope/body kind differs"}
+	}
+	return nil
+}
+
+// bindJavaV1Response 捕获确切future/旧合并缓存；合法TC→RM请求使用独立ID空间，不能被响应过滤。
+func (c *GettyRemotingClient) bindJavaV1Response(ctx context.Context, s getty.Session, r message.RpcMessage) (context.Context, bool) {
+	if !javaV1TransportEnabled() || (r.Type != message.RequestTypeResponse && !javaV1ReplyBody(r.Body)) {
+		return ctx, true
+	}
+	guard := &javaV1ResponseGuard{id: r.ID}
+	c.gettyRemoting.javaV1StateMutex.Lock()
+	defer c.gettyRemoting.javaV1StateMutex.Unlock()
+	if value, found := c.gettyRemoting.javaV1Pending.Load(r.ID); found {
+		entry := value.(*javaV1Pending)
+		if entry.session != s {
+			return ctx, false
+		}
+		guard.future = entry.future
+	} else {
+		guard.future = c.GetMessageFuture(r.ID)
+	}
+	c.mergeReplyMutex.Lock()
+	guard.request = c.GetMergedMessage(r.ID)
+	if guard.request != nil {
+		guard.ids = append([]int32(nil), guard.request.MsgIds...)
+		guard.plan, guard.planError = javaV1PlanFor(*guard.request)
+		for _, id := range guard.ids {
+			guard.children = append(guard.children, c.GetMessageFuture(id))
+		}
+	}
+	c.mergeReplyMutex.Unlock()
+	// 即使当前无等待者也保留空guard，防止暂停后的晚到响应完成此后出现的新ID所有者。
+	return context.WithValue(ctx, javaV1ResponseGuardKey{}, guard), true
+}
+
+// HandleJavaV1BoundResponse 由原response processor调用，发布至入站时捕获的对象，绝不重新按ID查找。
+// 返回handled=false表示非本模式/旧调用上下文，应继续原处理路径。
+func (c *GettyRemotingClient) HandleJavaV1BoundResponse(ctx context.Context, r message.RpcMessage) (bool, error) {
+	if ctx == nil {
+		return false, nil
+	}
+	guard, found := ctx.Value(javaV1ResponseGuardKey{}).(*javaV1ResponseGuard)
+	if !found {
+		return false, nil
+	}
+	err := javaV1ReplyEnvelopeError(r)
+	if r.ID != guard.id {
+		err = &JavaV1UnknownReplyError{Reason: "response context ID differs"}
+	}
+	if guard.future != nil {
+		if err != nil {
+			guard.future.CompleteWithError(nil, err)
+		} else {
+			guard.future.Complete(r.Body)
+		}
+		c.gettyRemoting.futures.CompareAndDelete(guard.id, guard.future)
+		if guard.request != nil {
+			c.gettyRemoting.mergeMsgMap.CompareAndDelete(guard.id, guard.request)
+		}
+		return true, err
+	}
+	if guard.request == nil {
+		return true, err
+	}
+	c.mergeReplyMutex.Lock()
+	defer c.mergeReplyMutex.Unlock()
+	if !c.gettyRemoting.mergeMsgMap.CompareAndDelete(guard.id, guard.request) {
+		return true, nil
+	}
+	if guard.planError != nil {
+		err = &JavaV1UnknownReplyError{Reason: guard.planError.Error()}
+	}
+	seen := make(map[int32]bool, len(guard.ids))
+	if guard.plan == nil || len(guard.ids) != len(guard.plan.types) {
+		err = &JavaV1UnknownReplyError{Reason: "merged request ID count differs"}
+	}
+	for _, id := range guard.ids {
+		if seen[id] {
+			err = &JavaV1UnknownReplyError{Reason: "duplicate merged request ID"}
+		}
+		seen[id] = true
+	}
+	if err == nil {
+		err = guard.plan.validate(r.Body)
+	}
+	var reply message.MergeResultMessage
+	if err == nil {
+		value, _ := javaV1SDKValue(r.Body)
+		reply = value.(message.MergeResultMessage)
+	}
+	for i, future := range guard.children {
+		if future == nil {
+			continue
+		}
+		if err != nil {
+			future.CompleteWithError(nil, err)
+		} else {
+			future.Complete(reply.Msgs[i])
+		}
+		c.gettyRemoting.futures.CompareAndDelete(guard.ids[i], future)
+	}
+	return true, err
+}
